#!/usr/bin/env bash
# The gate every milestone branch passes before it merges: format, lints, tests, build.
#   scripts/check            everything
#   scripts/check --no-test  skip the test run
set -euo pipefail
cd "$(dirname "$0")/.."
cargo fmt --all -- --check
cargo clippy --workspace --all-targets -- -D warnings
[[ "${1:-}" == "--no-test" ]] || cargo test --workspace
cargo build --package sonicly
